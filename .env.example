# AI features
# Keep this key server-only. Never rename it to NEXT_PUBLIC_GROQ_API_KEY.
GROQ_API_KEY=your_groq_api_key_here

# Enable Groq voice only after accepting the required terms in your Groq account.
# When disabled, voice output uses the browser's built-in speech support.
NEXT_PUBLIC_GROQ_TTS_ENABLED=false

# Portfolio profile, contact, and project links are configured in
# src/constants/env.js because they are public site content, not secrets.

# Optional video-call clips. Leave empty to show the contact avatar instead.
NEXT_PUBLIC_VIDEOCALL_KULDEEPRAJPUT=
NEXT_PUBLIC_VIDEOCALL_BHAVESH_KUMAR=
NEXT_PUBLIC_VIDEOCALL_MAHABUB=

# Optional public API keys and service endpoints
# This is a public client ID, not a secret API key.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=3dce8b55
# This key is exposed to browsers because the Apple TV interface calls TMDB directly.
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

NEXT_PUBLIC_GITHUB_API_URL=https://api.github.com
NEXT_PUBLIC_WEATHER_API_URL=https://wttr.in
NEXT_PUBLIC_NOMINATIM_API_URL=https://nominatim.openstreetmap.org
NEXT_PUBLIC_OPENSTREETMAP_URL=https://www.openstreetmap.org
